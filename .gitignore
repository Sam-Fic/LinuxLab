# 由 setup-toolchain.sh 下载的第三方二进制（不入库：避免仓库膨胀，也避免仓库层面分发二进制）
app/src/main/assets/alpine-aarch64.tar
app/src/main/assets/busybox-static-aarch64
app/src/main/jniLibs/

# 构建产物与本地配置
*.apk
*.aab
app/build/
build/
.gradle/
.kotlin/
local.properties
/.idea/

# NDK / CMake 原生构建产物（NDK 侧编译输出，随 SDK 版本变化，不应入库）
app/.cxx/
.externalNativeBuild/
captures/

# ZCode 工作目录
# .zcode/tmp 是我的临时区（独立 Gradle HOME、字节码反编译产物、静态原型截图），
# 单个会话就能涨到 1G 以上；.zcode/plans 是会话计划，同样属于本地状态。
.zcode/
